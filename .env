# Production backend origin. In local development, leaving this unset uses the Vite /api proxy.
VITE_API_BASE_URL=http://192.168.68.53:8080
VITE_API_TIMEOUT_MS=15000

# Override these only if the backend uses different admin routes.
VITE_ADMIN_LOGIN_ENDPOINT=/api/admin/auth/login
VITE_ADMIN_ENQUIRIES_ENDPOINT=/api/admin/inquiries
